{
  "name": "redactlocal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test \"tests/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-include=\"js/**\" --test-coverage-exclude=\"js/app.js\" --test-coverage-exclude=\"js/diff.js\" \"tests/*.test.js\"",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run test:coverage && npm run test:e2e",
    "build": "node scripts/build-site.mjs",
    "lighthouse": "npm run build && npx --yes @lhci/cli@0.14.0 autorun",
    "deploy:firebase": "npm run build && npx --yes firebase-tools@13 deploy --only hosting",
    "check:size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@axe-core/playwright": "4.14.0",
    "eslint": "9.14.0",
    "@eslint/js": "9.14.0",
    "globals": "15.12.0"
  }
}
